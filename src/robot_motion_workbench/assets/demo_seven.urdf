<?xml version="1.0"?>
<!-- Original workbench primitive fixture. Not a Flexiv or calibrated robot model. -->
<robot name="rmw_original_seven_axis_demo">
  <link name="base">
    <visual>
      <origin xyz="0 0 -0.025" />
      <geometry>
        <cylinder radius="0.09" length="0.05" />
      </geometry>
      <material name="silver">
        <color rgba="0.72 0.76 0.80 1" />
      </material>
    </visual>
  </link>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.025" length="0.12" />
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.42 0.65 1" />
      </material>
    </visual>
  </link>
  <joint name="axis1" type="revolute">
    <parent link="base" />
    <child link="link1" />
    <origin xyz="0 0 0.03" rpy="0.05 0.1 -0.05" />
    <axis xyz="0 0 1" />
    <limit lower="-2.5" upper="2.5" effort="1" velocity="1" />
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.025" length="0.12" />
      </geometry>
      <material name="silver">
        <color rgba="0.72 0.76 0.80 1" />
      </material>
    </visual>
  </link>
  <joint name="axis2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0.015 0 0.12" rpy="0 0.12 0.1" />
    <axis xyz="0 1 0" />
    <limit lower="-2.5" upper="2.5" effort="1" velocity="1" />
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.025" length="0.12" />
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.42 0.65 1" />
      </material>
    </visual>
  </link>
  <joint name="axis3" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0.015 0 0.12" rpy="0.05 0.1 -0.05" />
    <axis xyz="1 0 0" />
    <limit lower="-2.5" upper="2.5" effort="1" velocity="1" />
  </joint>
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.025" length="0.12" />
      </geometry>
      <material name="silver">
        <color rgba="0.72 0.76 0.80 1" />
      </material>
    </visual>
  </link>
  <joint name="axis4" type="revolute">
    <parent link="link3" />
    <child link="link4" />
    <origin xyz="0.015 0 0.12" rpy="0 0.12 0.1" />
    <axis xyz="0 1 0" />
    <limit lower="-2.5" upper="2.5" effort="1" velocity="1" />
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.025" length="0.12" />
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.42 0.65 1" />
      </material>
    </visual>
  </link>
  <joint name="axis5" type="revolute">
    <parent link="link4" />
    <child link="link5" />
    <origin xyz="0.015 0 0.12" rpy="0.05 0.1 -0.05" />
    <axis xyz="1 0 0" />
    <limit lower="-2.5" upper="2.5" effort="1" velocity="1" />
  </joint>
  <link name="link6">
    <visual>
      <origin xyz="0 0 0.06" />
      <geometry>
        <cylinder radius="0.025" length="0.12" />
      </geometry>
      <material name="silver">
        <color rgba="0.72 0.76 0.80 1" />
